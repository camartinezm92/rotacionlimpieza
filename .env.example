# GEMINI_API_KEY: Optional API key for Gemini AI neural model.
# In Render, add it in Environment Variables (Environment -> Add Environment Variable).
# The app automatically cleans any accidental whitespace or quotes, and has a local fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Port where the server listens (Render automatically sets this in production, e.g. 10000 or 3000)
PORT=3000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
